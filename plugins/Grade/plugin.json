{
    "name": "Grade",
    "plugin_type": "grade",
    "category": "Color",
    "color": "#ec4899",
    "inputs": [
        "Image"
    ],
    "outputs": [
        "Image"
    ],
    "parameters": [
        {
            "id": "blackpoint",
            "name": "Blackpoint",
            "type": "slider",
            "value": 0.0,
            "min": -1.0,
            "max": 1.0,
            "step": 0.01,
            "tooltip": "This input value becomes black (0)."
        },
        {
            "id": "whitepoint",
            "name": "Whitepoint",
            "type": "slider",
            "value": 1.0,
            "min": 0.0,
            "max": 2.0,
            "step": 0.01,
            "tooltip": "This input value becomes white (1)."
        },
        {
            "id": "lift",
            "name": "Lift",
            "type": "slider",
            "value": 0.0,
            "min": -1.0,
            "max": 1.0,
            "step": 0.01
        },
        {
            "id": "gain",
            "name": "Gain",
            "type": "slider",
            "value": 1.0,
            "min": 0.0,
            "max": 4.0,
            "step": 0.01
        },
        {
            "id": "multiply",
            "name": "Multiply",
            "type": "slider",
            "value": 1.0,
            "min": 0.0,
            "max": 4.0,
            "step": 0.01
        },
        {
            "id": "offset",
            "name": "Offset",
            "type": "slider",
            "value": 0.0,
            "min": -1.0,
            "max": 1.0,
            "step": 0.01
        },
        {
            "id": "gamma",
            "name": "Gamma",
            "type": "slider",
            "value": 1.0,
            "min": 0.1,
            "max": 4.0,
            "step": 0.01
        },
        {
            "id": "black_clamp",
            "name": "Black Clamp",
            "type": "checkbox",
            "value": true,
            "tooltip": "Clamp results below 0 (as Nuke)."
        },
        {
            "id": "white_clamp",
            "name": "White Clamp",
            "type": "checkbox",
            "value": false,
            "tooltip": "Clamp results above 1 (removes highlights)."
        },
        {
            "id": "unpremult",
            "name": "Unpremultiply by Alpha",
            "type": "checkbox",
            "value": false,
            "tooltip": "For premultiplied RGBA (e.g. the keyer's output): grade the colour, not the edges."
        }
    ],
    "worker_module": "plugins.Grade.backend",
    "worker_class": "GradeWorker"
}