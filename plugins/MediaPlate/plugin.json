{
    "name": "Media Plate",
    "plugin_type": "media_plate",
    "category": "Media",
    "color": "#64748b",
    "inputs": [],
    "outputs": ["Video Plate"],
    "parameters": [
        {"id": "plate_file", "name": "Media File", "type": "file", "value": ""},
