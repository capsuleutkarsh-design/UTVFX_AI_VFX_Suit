            "Linear Rec.709 (sRGB)",
            "sRGB Encoded Rec.709 (sRGB)",
            "Gamma 2.4 Encoded Rec.709",
            "ARRI LogC3 (EI800)",
            "ARRI LogC4",
            "S-Log3 S-Gamut3",
            "S-Log3 S-Gamut3.Cine",
            "Log3G10 REDWideGamutRGB",
            "V-Log V-Gamut",
            "CanonLog3 CinemaGamut D55",
            "Apple Log",
            "ADX10"
        ]}
    ],
    "worker_module": "plugins.MediaPlate.backend",
    "worker_class": "MediaWorker"
