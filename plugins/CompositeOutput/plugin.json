{
    "name": "Unified Output",
    "plugin_type": "composite_output",
    "category": "Output",
    "color": "#f43f5e",
    "inputs": [
        "Keyed RGBA",
        "Alpha Matte",
        "Video Plate",
        "3D Camera Path",
        "3D Sparse Points",
        "Dense Depth Map",
        "Shape Data"
    ],
    "outputs": [
        "Final Presentation",
        "Export Assets"
    ],
    "parameters": [
        {
            "id": "output_dir",
            "name": "Output Folder",
            "type": "folder",
            "value": ""
        },
        {
            "id": "shot_name",
            "name": "Shot Name (blank = project name)",
            "type": "text",
            "value": ""
        },
        {
            "id": "file_format",
            "name": "File Format",
            "type": "select",
            "value": "EXR half float",
            "options": [
                "EXR half float",
                "EXR full float",
                "PNG 16-bit (display)",
                "PNG 8-bit (display)"
            ]
        },
        {
            "id": "exr_colourspace",
            "name": "EXR Colour Space",
            "type": "select",
            "value": "ACEScg",
            "options": [
                "ACEScg",
                "ACES2065-1",
                "Linear Rec.709 (sRGB)"
            ]
        },
        {
            "id": "png_display",
            "name": "PNG Display",
            "type": "select",
            "value": "sRGB (ACES SDR Video)",
            "options": [
                "sRGB (ACES SDR Video)",
                "Rec.709 (ACES SDR Video)",
                "sRGB (Un-tone-mapped)"
            ]
        },
        {
            "id": "combine_exr",
            "name": "Also One Multi-channel EXR per Frame",
            "type": "checkbox",
            "value": false
        },
        {
            "id": "premultiply",
            "name": "Premultiply Plate by the Matte (combined EXR)",
            "type": "checkbox",
            "value": true
        },
        {
            "id": "split_core_edge",
            "name": "Also Write Core and Edge Mattes",
            "type": "checkbox",
            "value": false
        },
        {
            "id": "write_nuke_reads",
            "name": "Nuke Script with a Read per Layer",
            "type": "checkbox",
            "value": true
        },
        {
            "id": "export_camera",
            "name": "Export Camera (Nuke, Blender, .chan, USD, PLY)",
            "tab": "3D Export",
            "type": "checkbox",
            "value": true
        },
        {
            "id": "scene_scale",
            "name": "Scene Scale",
            "tab": "3D Export",
            "type": "slider",
            "value": 1.0,
            "min": 0.01,
            "max": 100.0,
            "step": 0.01,
            "tooltip": "Multiplies the whole scene (camera and points). COLMAP's units are arbitrary."
        },
        {
            "id": "level_ground",
            "name": "Level the Ground from the Point Cloud",
            "tab": "3D Export",
            "type": "checkbox",
            "value": false
        },
        {
            "id": "write_undistort",
            "name": "Write STMaps and Undistorted Plate",
            "tab": "3D Export",
            "type": "checkbox",
            "value": false
        },
        {
            "id": "overscan",
            "name": "Undistort Overscan",
            "tab": "3D Export",
            "type": "slider",
            "value": 0.0,
            "min": 0.0,
            "max": 0.5,
            "step": 0.01
        },
        {
            "id": "blender_exe",
            "name": "Blender (for Alembic and .blend)",
            "tab": "3D Export",
            "type": "file",
            "value": ""
        },
        {
            "id": "export_roto_nuke",
            "name": "Export Nuke Roto Script (.py)",
            "tab": "2D Export",
            "type": "checkbox",
            "value": true
        },
        {
            "id": "roto_interpolation",
            "name": "Sub-Frame Interpolation",
            "tab": "2D Export",
            "type": "select",
            "value": "Linear",
            "options": [
                "Linear",
                "Smooth"
            ],
            "tooltip": "Interpolation between roto keyframes"
        }
    ],
    "worker_module": "plugins.CompositeOutput.backend",
    "worker_class": "CompositeOutputWorker"
}