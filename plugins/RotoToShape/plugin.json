{
    "name": "Matte to Shape",
    "plugin_type": "roto_to_shape",
    "category": "Matte",
    "color": "#8b5cf6",
    "inputs": [
        "Video Plate",
        "Alpha Matte",
        "Depth Map"
    ],
    "outputs": [
        "Shape Data"
    ],
    "parameters": [
        {
            "id": "mode",
            "name": "Mode",
            "type": "select",
            "value": "Outline (any object)",
            "options": [
                "Outline (any object)",
                "Body parts (people)"
            ],
            "tooltip": "Outline traces whatever the matte shows. Body parts cuts a person into head, torso and limb shapes using their skeleton."
        },
        {
            "id": "point_mode",
            "name": "Point Mode",
            "type": "select",
            "value": "Auto (Adaptive)",
            "options": [
                "Auto (Adaptive)",
                "Fixed"
            ]
        },
        {
            "id": "auto_point_spacing",
            "name": "Point Spacing (px)",
            "type": "slider",
            "value": 30,
            "min": 10,
            "max": 100,
            "step": 5,
            "tooltip": "Lower = more points, higher = fewer points"
        },
        {
            "id": "target_points",
            "name": "Fixed Points",
            "type": "slider",
            "value": 100,
            "min": 10,
            "max": 500,
            "step": 10
        },
        {
            "id": "curvature_weight",
            "name": "Curvature Weight",
            "type": "slider",
            "value": 5.0,
            "min": 1.0,
            "max": 15.0,
            "step": 0.5,
            "tooltip": "How aggressively points cluster at curves vs. straights"
        },
        {
            "id": "corner_threshold",
            "name": "Corner Threshold (deg)",
            "type": "slider",
            "value": 45,
            "min": 10,
            "max": 90,
            "step": 5,
            "tooltip": "Where the matte's outline turns sharper than this, the point is a hard corner (cusp)"
        },
        {
            "id": "simplify_epsilon",
            "name": "Curve Smoothing",
            "type": "slider",
            "value": 1.0,
            "min": 0.0,
            "max": 10.0,
            "step": 0.5,
            "tooltip": "Higher = smoother/simpler curves, lower = more raw detail"
        },
        {
            "id": "edge_snap_radius",
            "name": "Edge Snap Radius (px)",
            "type": "slider",
            "value": 2,
            "min": 0,
            "max": 10,
            "step": 1,
            "tooltip": "How far points can shift to find the true matte edge"
        },
        {
            "id": "min_area",
            "name": "Minimum Area (px)",
            "type": "slider",
            "value": 100,
            "min": 0,
            "max": 10000,
            "step": 100
        },
        {
            "id": "edge_placement",
            "name": "Edge Placement (Soft <-> Hard)",
            "type": "slider",
            "value": 50,
            "min": 0,
            "max": 100,
            "step": 5,
            "tooltip": "Where the matte is cut into objects, and where the outline sits when Generate Feather is off: 0 = soft outer edge, 100 = hard inner core"
        },
        {
            "id": "generate_feather",
            "name": "Generate Feather",
            "type": "checkbox",
            "value": true,
            "tooltip": "Point on the solid core, feather where the matte has faded: Nuke's feather reproduces the soft edge"
        },
        {
            "id": "iou_threshold",
            "name": "Tracking Overlap",
            "type": "slider",
            "value": 0.3,
            "min": 0.05,
            "max": 1.0,
            "step": 0.05,
            "tooltip": "Min bounding-box overlap to consider shapes the same across frames"
        },
        {
            "id": "include_holes",
            "name": "Include Holes",
            "type": "checkbox",
            "value": false
        },
        {
            "id": "max_missing_frames",
            "name": "Max Missing Frames",
            "type": "slider",
            "value": 5,
            "min": 0,
            "max": 50,
            "step": 1
        },
        {
            "id": "temporal_smoothing",
            "name": "Temporal Smoothing",
            "type": "checkbox",
            "value": true,
            "tooltip": "3-frame rolling average to reduce AI matte jitter"
        },
        {
            "id": "first_frame",
            "name": "First frame (plate number, 0 = start)",
            "type": "slider",
            "value": 0,
            "min": 0,
            "max": 100000,
            "step": 1,
            "tooltip": "0 = start from beginning"
        },
        {
            "id": "last_frame",
            "name": "Last frame (plate number, 0 = end)",
            "type": "slider",
            "value": 0,
            "min": 0,
            "max": 100000,
            "step": 1,
            "tooltip": "0 = process to end"
        },
        {
            "id": "points_limb",
            "name": "Points per Limb (body parts)",
            "type": "slider",
            "value": 30,
            "min": 10,
            "max": 100,
            "step": 2
        },
        {
            "id": "points_torso",
            "name": "Points for Torso (body parts)",
            "type": "slider",
            "value": 60,
            "min": 20,
            "max": 200,
            "step": 4
        },
        {
            "id": "points_head",
            "name": "Points for Head (body parts)",
            "type": "slider",
            "value": 30,
            "min": 10,
            "max": 100,
            "step": 2
        },
        {
            "id": "hide_behind",
            "name": "Hide Limb Behind Body More Than",
            "type": "slider",
            "value": 0.08,
            "min": 0.0,
            "max": 0.5,
            "step": 0.01,
            "tooltip": "Body parts with a depth map: a limb fades out when it is more than this far behind the torso (fraction of the torso's distance)."
        },
        {
            "id": "show_again",
            "name": "Show Limb Again Below",
            "type": "slider",
            "value": 0.04,
            "min": 0.0,
            "max": 0.5,
            "step": 0.01
        }
    ],
    "worker_module": "plugins.RotoToShape.backend",
    "worker_class": "RotoToShapeWorker"
}